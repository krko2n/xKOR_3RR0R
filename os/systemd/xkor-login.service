[Unit]
Description=xKOR_3RR0R OS Mode Login Service
Documentation=https://github.com/krko2n/xKOR_3RR0R
After=systemd-user-sessions.service systemd-logind.service plymouth-quit-wait.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=xkor
WorkingDirectory=/opt/xkor_3rr0r

# CRITICAL: Enable PAM session to create /run/user/UID
# Without this, systemd-logind will NOT create XDG_RUNTIME_DIR
# and Hyprland will fail with socket initialization errors
PAMName=login

# Launch Hyprland via wrapper script (replaces old TTY login)
ExecStart=/opt/xkor_3rr0r/os/bin/start-hyprland

# Logging (captured by journalctl -u xkor-login)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xkor-os

# TTY allocation
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

# Restart policy
Restart=on-failure
RestartSec=3s

# Environment (inherited by compositor)
Environment="XDG_SESSION_TYPE=wayland"
Environment="XDG_CURRENT_DESKTOP=Hyprland"

[Install]
WantedBy=graphical.target